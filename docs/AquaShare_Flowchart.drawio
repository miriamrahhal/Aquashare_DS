<mxfile host="app.diagrams.net"><diagram id="aquashare-flow" name="AquaShare flowchart"><mxGraphModel dx="1600" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1500" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="AquaShare: how the water is shared" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="subL" value="1. A normal day on a farm" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#555555;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="130" y="66" width="400" height="30" as="geometry"/></mxCell><mxCell id="subR" value="2. Sending water to another farm" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#555555;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="66" width="400" height="30" as="geometry"/></mxCell><mxCell id="sep" value="" style="endArrow=none;dashed=1;strokeColor=#bbbbbb;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="70" as="sourcePoint"/><mxPoint x="800" y="1480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="L0" value="A new day starts" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#d5ecc2;strokeColor=#4c9c22;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="110" width="240" height="56" as="geometry"/></mxCell><mxCell id="L1" value="The operator opens the day:&lt;br&gt;sets the daily limit and&lt;br&gt;gives each farm its share" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dbeafe;strokeColor=#3b6fb6;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="195" y="205" width="270" height="70" as="geometry"/></mxCell><mxCell id="L2" value="The ledger tries to save it&lt;br&gt;on its 3 servers" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dbeafe;strokeColor=#3b6fb6;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="195" y="315" width="270" height="64" as="geometry"/></mxCell><mxCell id="L3" value="Do at least 2 of&lt;br&gt;the 3 servers&lt;br&gt;agree?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2b3;strokeColor=#b8950b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="420" width="240" height="120" as="geometry"/></mxCell><mxCell id="L3n" value="Wait and try again.&lt;br&gt;Nothing is saved yet." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe1bf;strokeColor=#d07a12;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="442" width="240" height="76" as="geometry"/></mxCell><mxCell id="L4" value="Each farm receives its&lt;br&gt;share on its next sync" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dbeafe;strokeColor=#3b6fb6;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="195" y="585" width="270" height="64" as="geometry"/></mxCell><mxCell id="L5" value="The farm checks the soil" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dbeafe;strokeColor=#3b6fb6;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="195" y="690" width="270" height="56" as="geometry"/></mxCell><mxCell id="L6" value="Is the soil&lt;br&gt;dry?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2b3;strokeColor=#b8950b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="785" width="240" height="110" as="geometry"/></mxCell><mxCell id="L7" value="Is there water&lt;br&gt;left in the farm&#x27;s&lt;br&gt;share?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2b3;strokeColor=#b8950b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="935" width="240" height="120" as="geometry"/></mxCell><mxCell id="L7n" value="Close the valve.&lt;br&gt;The share is used up." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fbd5d5;strokeColor=#c0392b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="957" width="240" height="76" as="geometry"/></mxCell><mxCell id="L7e" value="Wait for the next day" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#d5ecc2;strokeColor=#4c9c22;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="1080" width="240" height="56" as="geometry"/></mxCell><mxCell id="L8" value="Open the valve and water&lt;br&gt;the field. Write it down in&lt;br&gt;the farm&#x27;s own journal" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dbeafe;strokeColor=#3b6fb6;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="195" y="1100" width="270" height="70" as="geometry"/></mxCell><mxCell id="L9" value="Is the farm&lt;br&gt;connected to&lt;br&gt;the network?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2b3;strokeColor=#b8950b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="1215" width="240" height="120" as="geometry"/></mxCell><mxCell id="L9n" value="Keep the updates on the&lt;br&gt;farm and send them later" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe1bf;strokeColor=#d07a12;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="1237" width="240" height="76" as="geometry"/></mxCell><mxCell id="L10" value="Send the water used to the&lt;br&gt;ledger. Each update is&lt;br&gt;counted only once" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dbeafe;strokeColor=#3b6fb6;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="195" y="1380" width="270" height="70" as="geometry"/></mxCell><mxCell id="R0" value="Farm A wants to send&lt;br&gt;water to Farm B" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#d5ecc2;strokeColor=#4c9c22;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="300" height="56" as="geometry"/></mxCell><mxCell id="R1" value="Does Farm A have&lt;br&gt;enough water left?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2b3;strokeColor=#b8950b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1035" y="205" width="250" height="120" as="geometry"/></mxCell><mxCell id="R1n" value="Refuse.&lt;br&gt;Nothing changes." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fbd5d5;strokeColor=#c0392b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="227" width="200" height="76" as="geometry"/></mxCell><mxCell id="R2" value="Put the water on hold at&lt;br&gt;Farm A (it can&#x27;t be used twice)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dbeafe;strokeColor=#3b6fb6;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="370" width="280" height="64" as="geometry"/></mxCell><mxCell id="R3" value="Ask the ledger to save&lt;br&gt;the transfer (via the gateway)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dbeafe;strokeColor=#3b6fb6;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="475" width="280" height="64" as="geometry"/></mxCell><mxCell id="R4" value="What does the&lt;br&gt;ledger answer?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2b3;strokeColor=#b8950b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1035" y="580" width="250" height="130" as="geometry"/></mxCell><mxCell id="R4n" value="Keep the water on hold&lt;br&gt;and try again with the&lt;br&gt;same transfer ID" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe1bf;strokeColor=#d07a12;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="600" width="190" height="90" as="geometry"/></mxCell><mxCell id="R4l" value="Give the water&lt;br&gt;back to Farm A" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fbd5d5;strokeColor=#c0392b;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="785" y="607" width="170" height="76" as="geometry"/></mxCell><mxCell id="R5" value="Confirm: Farm A loses the&lt;br&gt;water, Farm B gets it on&lt;br&gt;its next sync" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dbeafe;strokeColor=#3b6fb6;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="765" width="280" height="70" as="geometry"/></mxCell><mxCell id="R6" value="Transfer done ✓" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#d5ecc2;strokeColor=#4c9c22;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1030" y="880" width="260" height="56" as="geometry"/></mxCell><mxCell id="K" value="&lt;b&gt;Key words&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Ledger&lt;/b&gt;: 3 servers that keep the official record&lt;br&gt;  of who got how much water&lt;br&gt;• &lt;b&gt;Majority&lt;/b&gt;: at least 2 of the 3 servers. If one crashes,&lt;br&gt;  the other 2 pick a new leader in about 2 seconds&lt;br&gt;• &lt;b&gt;Share&lt;/b&gt;: the water a farm is allowed to use today&lt;br&gt;• &lt;b&gt;Sync&lt;/b&gt;: the farm and the ledger exchanging updates&lt;br&gt;• &lt;b&gt;On hold&lt;/b&gt;: water reserved for a transfer, so it&lt;br&gt;  can&#x27;t be watered or sent twice" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="990" width="440" height="200" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0" target="L1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L3" target="L3n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3" value="No" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="425" y="456" width="120" height="20" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L3n" target="L2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="347"/></Array></mxGeometry></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l5" value="Yes" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="550" width="120" height="20" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L5" target="L6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L6" target="L5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="840"/><mxPoint x="560" y="718"/></Array></mxGeometry></mxCell><mxCell id="l8" value="No" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="818" width="120" height="20" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L6" target="L7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l9" value="Yes" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="902" width="120" height="20" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L7" target="L7n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l10" value="No" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="425" y="971" width="120" height="20" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L7n" target="L7e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L7" target="L8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l12" value="Yes" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="1067" width="120" height="20" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0